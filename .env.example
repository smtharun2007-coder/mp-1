# Disaster Relief System - Environment Configuration
# MongoDB Atlas Connection String (Required in production/Atlas mode)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Database Names
MONGODB_DB=relief
MONGODB_TEST_DB=relief_test

# Web Server Port
PORT=7070

# Optional Demo Passwords (if unset, randomly generated at first startup)
DEMO_CONTROL_PASSWORD=Admin@12345
DEMO_OFFICER_PASSWORD=Officer@12345
